# Talos Homelab Configuration
# Copy this file to config.env and fill in your values

# ===================
# CLUSTER SETTINGS
# ===================

CLUSTER_NAME="talos-homelab"
KUBERNETES_VERSION="1.32.0"
TALOS_VERSION="v1.11.5"

# Control Plane
CP_IP="192.168.1.115"
CP_HOSTNAME="talos-cp-01"

# Worker 1
WORKER1_IP="192.168.1.116"
WORKER1_HOSTNAME="talos-worker-01"

# Worker 2
WORKER2_IP="192.168.1.151"
WORKER2_HOSTNAME="talos-worker-02"

# Network
GATEWAY="192.168.1.1"
DNS_SERVERS="8.8.8.8,1.1.1.1"
NETWORK_INTERFACE="ens18"

# MetalLB IP Pool
METALLB_IP_RANGE="192.168.1.155-192.168.1.159"

# ===================
# CLOUDFLARE SETTINGS
# ===================

CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_API_TOKEN="your-api-token"
CLOUDFLARE_DOMAIN="yourdomain.com"
CLOUDFLARE_EMAIL="your-email@example.com"

# If using existing tunnel
CLOUDFLARE_TUNNEL_ID=""
CLOUDFLARE_TUNNEL_NAME=""
CLOUDFLARE_TUNNEL_SECRET=""

# ===================
# TALOS IMAGE
# ===================

# Custom Talos image with Longhorn extensions
# Generated from factory.talos.dev with:
# - siderolabs/iscsi-tools
# - siderolabs/util-linux-tools
TALOS_IMAGE_SCHEMATIC="53513e54bb39202f35694412577a6bc53d484744d35a126e5d42ef34785c0d83"

# ===================
# PROXMOX SETTINGS (Optional)
# ===================

PROXMOX_HOST_1="proxmox1.local"
PROXMOX_HOST_2="proxmox2.local"
PROXMOX_USER="root"
PROXMOX_STORAGE="local-lvm"

# VM IDs
CP_VMID="108"
WORKER1_VMID="110"
WORKER2_VMID="112"
